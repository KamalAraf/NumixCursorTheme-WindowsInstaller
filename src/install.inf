[DefaultInstall]
DelReg    = Scheme.DelReg
CopyFiles = Scheme.Cur, Scheme.Ani
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"Cursors\Numix-Dark"
Scheme.Ani = 10,"Cursors\Numix-Dark"

[Scheme.DelReg]
HKCU,"Control Panel\Cursors\Schemes","Numix-Dark"
HKCU,"Control Panel\Cursors\Schemes","Numix Dark"
HKCU,"Control Panel\Cursors\Schemes","Numix-Cursor-Dark"

; REG_EXPAND_SZ (0x00020000) ensures %SystemRoot% expands correctly at runtime.
; %CURSOR_DIR% defined in [Strings] prevents INF comma-parsing from truncating the value.
; Slot order: Normal, Help, AppStarting, Wait, Crosshair, IBeam, NWPen,
;             Unavailable, SizeNS, SizeWE, SizeNWSE, SizeNESW, SizeAll, UpArrow, Hand
[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","Numix-Dark",0x00020000,"%CURSOR_DIR%\default.cur,%CURSOR_DIR%\help.cur,%CURSOR_DIR%\progress.ani,%CURSOR_DIR%\wait.ani,%CURSOR_DIR%\crosshair.cur,%CURSOR_DIR%\text.cur,%CURSOR_DIR%\pencil.cur,%CURSOR_DIR%\not-allowed.cur,%CURSOR_DIR%\size_ver.cur,%CURSOR_DIR%\size_hor.cur,%CURSOR_DIR%\size_fdiag.cur,%CURSOR_DIR%\size_bdiag.cur,%CURSOR_DIR%\fleur.cur,%CURSOR_DIR%\up-arrow.cur,%CURSOR_DIR%\pointer.cur"

